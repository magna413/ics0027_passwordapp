# Production Environment Configuration
# Copy this file to .env and fill in your production values

# Database URL (required for production)
# SQLite: file:./prisma/prod.db (default)
# PostgreSQL: postgresql://user:password@host:5432/password_manager
DATABASE_URL=file:./prisma/prod.db

# NextAuth Configuration (required)
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_secure_secret_here_change_this

# NextAuth URL (required in production)
# Set to your application's public URL
NEXTAUTH_URL=http://localhost:5123

# Port (optional, defaults to 3000)
PORT=5123

# Environment
NODE_ENV=production

# OPAQUE Server Setup (required)
# Base64-encoded OPAQUE server parameters (P-256 by default)
# Generate with: node -e "const opaque = require('@serenity-kit/opaque'); opaque.ready.then(() => { const setup = opaque.server.createServerSetup(); console.log(Buffer.from(setup).toString('base64')); }).catch(err => console.error(err));"
OPAQUE_SERVER_SETUP=
