generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique

  // OPAQUE
  opaqueRegistrationRecord String? // set after OPAQUE registration finishes

  mfaSecret String? // base32

  wrappingSalt Bytes // random salt for EK derivation
  wrappedDEK   Bytes // DEK encrypted with EK (AES-GCM)

  createdAt                    DateTime                       @default(now())
  credentials                  Credential[]
  serverLoginStates            ServerLoginState[]
  logs                         AuditLog[]
  opaqueSessions               OpaqueSession[]
  serverChangePasswordStates   ServerChangePasswordState[]
}

// Optionally keep per-user login state if you don’t use Redis
model ServerLoginState {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  email            String
  serverLoginState String // server’s opaque state for this login attempt
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model OpaqueSession {
  id              String   @id @default(cuid())
  userId          String
  token           String?   @unique   // one-time token used by NextAuth Credentials provider
  used            Boolean  @default(false)
  mfaVerified     Boolean  @default(false) // true only after TOTP is successfully verified
  createdAt       DateTime @default(now())
  expiresAt       DateTime // session expires after 5 minutes

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServerChangePasswordState {
  id                        String   @id @default(cuid())
  userId                    String
  serverChangePasswordState String   // server's opaque state for this password change attempt
  createdAt                 DateTime @default(now())

  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Credential {
  id       String  @id @default(cuid())
  userId   String
  title    String
  username String
  url      String?

  ciphertext Bytes
  iv         Bytes
  tag        Bytes
  aad        Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  userAgent String?
  ts        DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
